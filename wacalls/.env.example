# wacalls — microserviço de chamadas WhatsApp (whatsmeow)

# Porta desta API de gestão
LISTEN_ADDR=:8090

# Backend principal (para POST /call-logs e notificações)
BACKEND_URL=http://localhost:8080

# Mesmo token definido no backend — autentica POST /call-logs E esta API
INTERNAL_SERVICE_TOKEN=

# Banco de sessões (sqlite; troque por postgres DSN em produção pesada)
WACALLS_SESSION_DB=file:wacalls.db?_foreign_keys=on

LOG_LEVEL=INFO
