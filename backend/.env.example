# ============================================
# 9s76hm2 — Backend .env (exemplo)
# Copie para .env e preencha os valores reais.
# ============================================

# --- Core ---
NODE_ENV=production
PORT=8080
BACKEND_URL=https://api.seudominio.com.br
FRONTEND_URL=https://app.seudominio.com.br
JWT_SECRET=troque_por_um_segredo_longo_aleatorio
JWT_REFRESH_SECRET=troque_por_outro_segredo_longo
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# --- Banco de dados ---
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whaticket
DB_USER=postgres
DB_PASS=troque
DB_SSL=false

# --- Redis (filas Bull / cache / sessões) ---
REDIS_URI=redis://localhost:6379
REDIS_URI_ACK=redis://localhost:6379
REDIS_URI_MSG_CONN=redis://localhost:6379
IO_REDIS_SERVER=localhost
IO_REDIS_PORT=6379
IO_REDIS_PASSWORD=
IO_REDIS_DB_SESSION=3
IO_REDIS_DB_CACHE=4
IO_REDIS_DB_BULL=5

# --- Meta / Facebook / Instagram OAuth (SaaS) ---
# App global da plataforma no Meta for Developers.
# Empresas podem sobrescrever por conexão via campos metaAppId/metaAppSecret.
META_APP_ID=
META_APP_SECRET=
# Segredo HMAC do "state" OAuth (anti-CSRF). Se vazio, usa JWT_SECRET.
APP_SECRET_META_STATE=

# --- Webhooks Meta (Facebook Pages / Instagram) ---
# Token de verificação do webhook (GET /webhook). Cada conexão pode ter
# metaWebhookVerifyToken próprio; este é o fallback global.
VERIFY_TOKEN=
# Token de verificação do webhook WhatsApp Cloud API (GET /webhooks/whatsapp)
WABA_WEBHOOK_VERIFY_TOKEN=

# --- WhatsApp Cloud API (API Oficial) ---
WABA_API_VERSION=v19.0

# --- E-mail (SMTP) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Cotação USD→BRL (custos WhatsApp API Oficial) ---
USD_BRL_RATE=5.60

# --- Limites de envio ---
CAP_HOURLY=200
CAP_DAILY=1000
MESSAGE_INTERVAL_SEC=20
GREATER_INTERVAL_SEC=60
LONGER_INTERVAL_AFTER=10

# --- Sessões Baileys ---
SESSIONS_DRIVER=file
SESSIONS_DIR=./sessions
